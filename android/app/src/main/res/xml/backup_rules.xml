<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 11 and below.

  The pantry database is backed up so a new phone keeps the user's data, but
  shared_preferences is not: it holds the pending store receipt, which could be
  replayed against verifyReceipt if a backup were ever extracted.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
</full-backup-content>
