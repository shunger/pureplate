{
  "functions": {
    "source": "functions",
    "codebase": "purepantry",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "smart-shopping-scanner-1e045",
          "appId": "1:816594199281:android:26216765b0f14466d5bf50",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "smart-shopping-scanner-1e045",
          "appId": "1:816594199281:ios:791229c736ffa280d5bf50",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "smart-shopping-scanner-1e045",
          "configurations": {
            "android": "1:816594199281:android:26216765b0f14466d5bf50",
            "ios": "1:816594199281:ios:791229c736ffa280d5bf50"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
