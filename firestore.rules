rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User quota documents — only the owning user can read/write.
    match /users/{uid}/quota/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared pantries — owner and collaborators can read/write.
    match /sharedPantries/{pantryId} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.collaborators.keys()
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.collaborators.keys()
      );

      // Items within a shared pantry.
      match /items/{itemId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/sharedPantries/$(pantryId)).data.ownerUid == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/sharedPantries/$(pantryId)).data.collaborators.keys()
        );
      }
    }

    // Community-contributed products (doc ID = barcode).
    // Shared with Smart Shopping Scanner — same schema & rules.
    match /communityProducts/{barcode} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        // Field whitelist: required + optional
        && request.resource.data.keys().hasAll(['name', 'contributedBy', 'contributedAt', 'confirmationCount', 'confirmedBy', 'flagCount', 'flaggedBy', 'offSubmitted'])
        && request.resource.data.keys().hasOnly(['name', 'brand', 'category', 'contributedBy', 'contributedAt', 'confirmationCount', 'confirmedBy', 'flagCount', 'flaggedBy', 'offSubmitted'])
        // Ownership
        && request.resource.data.contributedBy is string
        && request.resource.data.contributedBy == request.auth.uid
        // Name validation
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        // Optional field type & size guards
        && (!request.resource.data.keys().hasAny(['brand']) || (request.resource.data.brand is string && request.resource.data.brand.size() <= 200))
        && (!request.resource.data.keys().hasAny(['category']) || (request.resource.data.category is string && request.resource.data.category.size() <= 50))
        // Initial counters & arrays must be zeroed
        && request.resource.data.confirmationCount == 0
        && request.resource.data.confirmedBy == []
        && request.resource.data.flagCount == 0
        && request.resource.data.flaggedBy == []
        && request.resource.data.offSubmitted == false;

      // Updates restricted to confirm/flag fields only
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmationCount', 'confirmedBy', 'flagCount', 'flaggedBy']);

      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
