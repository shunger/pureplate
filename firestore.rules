rules_version = '2';

// Shared Firestore rules for the smart-shopping-scanner-1e045 project.
//
// This project is shared by the published Smart Shopping Scanner app and
// Pure Pantry AI. The sharedLists / sharedPantries / communityProducts /
// users blocks serve every shipped scanner build, so they may only reject
// writes that no scanner or Pure Pantry build makes. Pure Pantry also has
// server-owned subcollections (marked "Pure Pantry").
//
// This repo is the ONLY place these rules are deployed from; the scanner repo
// keeps a reference copy. Run `npm run test:rules` (in functions/) before every
// deploy — it covers every scanner and Pure Pantry write, old builds included.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared list / pantry helpers ──────────────────────────────

    // A new shared list or pantry: the creator owns it and is its only member.
    function isValidNewShared() {
      let data = request.resource.data;
      return data.ownerUid == request.auth.uid
          && data.collaborators is map
          && data.collaborators.keys().hasOnly([request.auth.uid])
          && data.collaborators[request.auth.uid].role == 'owner';
    }

    // The member entry every app writes when joining with an invite code.
    function isJoinEntry(entry) {
      return entry is map
          && entry.keys().hasOnly(['role', 'displayName', 'sourceApp'])
          && entry.role == 'editor'
          && (!('displayName' in entry)
              || (entry.displayName is string && entry.displayName.size() <= 100));
    }

    // Updates any app legitimately makes to a shared list or pantry:
    //   members  – regenerate/revoke the invite code, bump updatedAt, re-save
    //              their own entry (re-joining), leave; the owner may also
    //              remove other members.
    //   joiners  – a non-member adds only their own entry.
    // Ownership and the list/pantry name never change after creation, and
    // the owner can't be removed.
    function isValidSharedUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let uid = request.auth.uid;
      let changed = after.diff(before).affectedKeys();
      let members = after.collaborators.diff(before.collaborators);
      let isOwner = uid == before.ownerUid;
      return after.collaborators is map
          && !members.removedKeys().hasAny([before.ownerUid])
          && (uid in before.collaborators
              ? changed.hasOnly(['collaborators', 'inviteCode', 'inviteCodeCreatedAt',
                                 'inviteCodeExpiresAt', 'updatedAt'])
                  && members.addedKeys().size() == 0
                  && (isOwner || members.removedKeys().hasOnly([uid]))
                  && members.changedKeys().hasOnly([uid])
                  && (!(uid in members.changedKeys()) || isOwner
                      || isJoinEntry(after.collaborators[uid]))
              : changed.hasOnly(['collaborators', 'updatedAt'])
                  && members.addedKeys().hasOnly([uid])
                  && members.removedKeys().size() == 0
                  && members.changedKeys().size() == 0
                  && isJoinEntry(after.collaborators[uid]));
    }

    // Activity events notify every other member (onListActivity /
    // onPantryActivity), so they must come from the signed-in user and carry
    // only the fields and types the apps write.
    function isValidActivity() {
      let data = request.resource.data;
      return data.keys().hasOnly(['type', 'actorUid', 'actorDisplayName',
                                  'itemName', 'details', 'timestamp'])
          && data.actorUid == request.auth.uid
          && data.type in ['itemAdded', 'itemChecked', 'itemUnchecked',
                           'itemRemoved', 'quantityChanged', 'collaboratorJoined',
                           'statusChanged', 'itemDepleted']
          && data.actorDisplayName is string
          && data.actorDisplayName.size() <= 100
          && (!('itemName' in data)
              || (data.itemName is string && data.itemName.size() <= 200))
          && (!('details' in data) || data.details is map)
          && data.timestamp == request.time;
    }

    // ── Shared Lists ──────────────────────────────────────────────
    match /sharedLists/{listId} {
      // Anyone authenticated can read (needed for join-by-invite lookup by
      // shipped scanner builds). Closing this needs a server-side join.
      allow read: if request.auth != null;

      allow create: if request.auth != null && isValidNewShared();

      allow update: if request.auth != null && isValidSharedUpdate();

      // Only owner can delete
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;

      // Items subcollection: collaborators only
      match /items/{itemId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/sharedLists/$(listId)).data.collaborators;
        allow write: if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/sharedLists/$(listId)).data.collaborators;
      }

      // Activity subcollection: collaborators can read and create their own
      match /activity/{activityId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/sharedLists/$(listId)).data.collaborators;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/sharedLists/$(listId)).data.collaborators
                      && isValidActivity();
        allow update, delete: if false;
      }
    }

    // ── Shared Pantries ───────────────────────────────────────────
    match /sharedPantries/{pantryId} {
      // Anyone authenticated can read (needed for join-by-invite lookup by
      // shipped scanner builds). Closing this needs a server-side join.
      allow read: if request.auth != null;

      allow create: if request.auth != null && isValidNewShared();

      allow update: if request.auth != null && isValidSharedUpdate();

      // Only owner can delete
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;

      // Items subcollection: collaborators only
      match /items/{itemId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/sharedPantries/$(pantryId)).data.collaborators;
        allow write: if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/sharedPantries/$(pantryId)).data.collaborators;
      }

      // Activity subcollection: collaborators can read and create their own
      match /activity/{activityId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/sharedPantries/$(pantryId)).data.collaborators;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/sharedPantries/$(pantryId)).data.collaborators
                      && isValidActivity();
        allow update, delete: if false;
      }
    }

    // ── Community Products ────────────────────────────────────────

    // Confirming or flagging: someone other than the contributor adds only
    // themselves to confirmedBy/flaggedBy, and the count matches the list.
    function isVote(countField, votersField) {
      let before = resource.data.get(votersField, []);
      let after = request.resource.data.get(votersField, []);
      return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([countField, votersField])
          && after is list
          && !(request.auth.uid in before)
          && after.size() == before.size() + 1
          && after.toSet() == before.toSet().union([request.auth.uid].toSet())
          && request.resource.data[countField] == after.size();
    }

    match /communityProducts/{barcode} {
      // Any authenticated user can read community products
      allow read: if request.auth != null;

      // A new product submitted by the signed-in user, with no votes yet.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                         'name', 'brand', 'category', 'contributedBy', 'contributedAt',
                         'confirmationCount', 'confirmedBy', 'flagCount', 'flaggedBy',
                         'offSubmitted'])
                    && request.resource.data.contributedBy == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && (!('brand' in request.resource.data)
                        || (request.resource.data.brand is string
                            && request.resource.data.brand.size() <= 200))
                    && (!('category' in request.resource.data)
                        || (request.resource.data.category is string
                            && request.resource.data.category.size() <= 50))
                    && request.resource.data.contributedAt is timestamp
                    && request.resource.data.confirmationCount == 0
                    && request.resource.data.confirmedBy == []
                    && request.resource.data.flagCount == 0
                    && request.resource.data.flaggedBy == []
                    && request.resource.data.offSubmitted == false;

      // Only confirm/flag votes; contributors can't vote on their own product.
      allow update: if request.auth != null
                    && resource.data.contributedBy != request.auth.uid
                    && (isVote('confirmationCount', 'confirmedBy')
                        || isVote('flagCount', 'flaggedBy'));

      // Community products cannot be deleted by clients
      allow delete: if false;
    }

    // ── Users (FCM tokens) ────────────────────────────────────────
    match /users/{uid} {
      // Users can only read and write their own document
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;

      // Pure Pantry: AI quota — read-only to the owner, written only by
      // Cloud Functions (Admin SDK bypasses rules). Client writes are denied
      // because a client could otherwise reset planCount/weekStart and bypass
      // all AI metering.
      match /quota/{doc} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // Pure Pantry: entitlement — the server-owned source of truth for
      // premium status. Written only by verifyReceipt and the store
      // notification handlers.
      match /entitlement/{doc} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Pure Pantry: maps a store subscription (Apple originalTransactionId,
    // or the SHA-256 of a Google purchase token) back to a uid so renewal
    // notifications can find the right account. Server-only in both
    // directions.
    match /subscriptionIndex/{id} {
      allow read, write: if false;
    }

    // ── Default deny ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
