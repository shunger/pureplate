rules_version = '2';

// Shared Firestore rules for the smart-shopping-scanner-1e045 project.
//
// This project is shared by the published Smart Shopping Scanner app and
// Pure Pantry AI. The sharedLists / sharedPantries / communityProducts /
// users blocks below are the scanner's production rules, kept VERBATIM so
// every shipped scanner build keeps working. Pure Pantry only ADDS the
// server-owned subcollections and index it needs (marked "Pure Pantry").
//
// If you change anything here, keep the scanner blocks a strict superset of
// what they are today and deploy from whichever repo holds the newest copy.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared Lists ──────────────────────────────────────────────
    match /sharedLists/{listId} {
      // Anyone authenticated can read (needed for join-by-invite lookup)
      allow read: if request.auth != null;

      // Only the creator (ownerUid) can create a list
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;

      // Owner can update anything; non-collaborators can add themselves
      // (join flow), collaborators can update collaborators field
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.ownerUid
                        || request.auth.uid in resource.data.collaborators
                        || request.auth.uid in request.resource.data.collaborators);

      // Only owner can delete
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;

      // Items subcollection: collaborators only
      match /items/{itemId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/sharedLists/$(listId)).data.collaborators;
        allow write: if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/sharedLists/$(listId)).data.collaborators;
      }

      // Activity subcollection: collaborators can read and create
      match /activity/{activityId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/sharedLists/$(listId)).data.collaborators;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/sharedLists/$(listId)).data.collaborators;
        allow update, delete: if false;
      }
    }

    // ── Shared Pantries ───────────────────────────────────────────
    match /sharedPantries/{pantryId} {
      // Anyone authenticated can read (needed for join-by-invite lookup)
      allow read: if request.auth != null;

      // Only the creator can create a pantry
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;

      // Owner and collaborators can update; join flow allows adding self
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.ownerUid
                        || request.auth.uid in resource.data.collaborators
                        || request.auth.uid in request.resource.data.collaborators);

      // Only owner can delete
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;

      // Items subcollection: collaborators only
      match /items/{itemId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/sharedPantries/$(pantryId)).data.collaborators;
        allow write: if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/sharedPantries/$(pantryId)).data.collaborators;
      }

      // Activity subcollection: collaborators can read and create
      match /activity/{activityId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/sharedPantries/$(pantryId)).data.collaborators;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/sharedPantries/$(pantryId)).data.collaborators;
        allow update, delete: if false;
      }
    }

    // ── Community Products ────────────────────────────────────────
    match /communityProducts/{barcode} {
      // Any authenticated user can read community products
      allow read: if request.auth != null;

      // Any authenticated user can create (submit) a new product,
      // and must set themselves as the contributor
      allow create: if request.auth != null
                    && request.resource.data.contributedBy == request.auth.uid;

      // Updates are allowed for confirm/flag operations by authenticated
      // users. The transaction logic in the app enforces that users
      // cannot confirm/flag their own submissions or double-count.
      allow update: if request.auth != null;

      // Community products cannot be deleted by clients
      allow delete: if false;
    }

    // ── Users (FCM tokens) ────────────────────────────────────────
    match /users/{uid} {
      // Users can only read and write their own document
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;

      // Pure Pantry: AI quota — read-only to the owner, written only by
      // Cloud Functions (Admin SDK bypasses rules). Client writes are denied
      // because a client could otherwise reset planCount/weekStart and bypass
      // all AI metering.
      match /quota/{doc} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // Pure Pantry: entitlement — the server-owned source of truth for
      // premium status. Written only by verifyReceipt and the store
      // notification handlers.
      match /entitlement/{doc} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Pure Pantry: maps a store subscription (Apple originalTransactionId,
    // or the SHA-256 of a Google purchase token) back to a uid so renewal
    // notifications can find the right account. Server-only in both
    // directions.
    match /subscriptionIndex/{id} {
      allow read, write: if false;
    }

    // ── Default deny ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
